<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/app_calculator"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3">

            <TextView
                android:id="@+id/display"
                style="@style/Calculator.Display"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:longClickable="false"
                android:textColor="@color/calculator_black"
                android:visibility="gone" />

            <TextView
                android:id="@+id/display_long_clickable"
                style="@style/Calculator.Display"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:textColor="@color/calculator_black"
                android:visibility="gone" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/delete"
            style="@style/Calculator.Button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="Delete"
            android:src="@android:drawable/ic_input_delete"
            android:tint="@color/calculator_black" />

        <ImageButton
            android:id="@+id/clear"
            style="@style/Calculator.Button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="Clear"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="@color/calculator_black"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <Button
            android:id="@+id/digit7"
            style="@style/Calculator.Button"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="7"
            android:textColor="@color/calculator_black" />

        <Button
            android:id="@+id/digit8"
            style="@style/Calculator.Button"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="8"
            android:textColor="@color/calculator_black" />

        <Button
            android:id="@+id/digit9"
            style="@style/Calculator.Button"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="9"
            android:textColor="@color/calculator_black" />

        <Button
            android:id="@+id/div"
            style="@style/Calculator.Button"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="÷"
            android:textColor="@color/calculator_black" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <Button
            android:id="@+id/digit4"
            style="@style/Calculator.Button"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="4"
            android:textColor="@color/calculator_black" />

        <Button
            android:id="@+id/digit5"
            style="@style/Calculator.Button"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="5"
            android:textColor="@color/calculator_black" />

        <Button
            android:id="@+id/digit6"
            style="@style/Calculator.Button"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="6"
            android:textColor="@color/calculator_black" />

        <Button
            android:id="@+id/mul"
            style="@style/Calculator.Button"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="×"
            android:textColor="@color/calculator_black" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <Button
            android:id="@+id/digit1"
            style="@style/Calculator.Button"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="1"
            android:textColor="@color/calculator_black" />

        <Button
            android:id="@+id/digit2"
            style="@style/Calculator.Button"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="2"
            android:textColor="@color/calculator_black" />

        <Button
            android:id="@+id/digit3"
            style="@style/Calculator.Button"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="3"
            android:textColor="@color/calculator_black" />

        <Button
            android:id="@+id/minus"
            style="@style/Calculator.Button"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="−"
            android:textColor="@color/calculator_black" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <Button
            android:id="@+id/digit0"
            style="@style/Calculator.Button"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="0"
            android:textColor="@color/calculator_black" />

        <Button
            android:id="@+id/dot"
            style="@style/Calculator.Button"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="."
            android:textColor="@color/calculator_black" />

        <Button
            android:id="@+id/equal"
            style="@style/Calculator.Button"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="="
            android:textColor="@color/calculator_black" />

        <Button
            android:id="@+id/plus"
            style="@style/Calculator.Button"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="+"
            android:textColor="@color/calculator_black" />
    </LinearLayout>
</LinearLayout>
